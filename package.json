{
  "name": "biblioteca-web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && wrangler dev",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:worker": "tsc -p tsconfig.worker.json",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "dev:cloudflare": "pnpm build && wrangler dev --local",
    "deploy:biblioteca-api": "wrangler deploy --config wrangler.api.jsonc",
    "dev:cms": "BIND_HOST=127.0.0.1 decap-server",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:cms-auth": "wrangler deploy --config infra/decap-oauth-worker/wrangler.toml"
  },
  "dependencies": {

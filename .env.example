# Web3Forms - Formulario de contacto coa Comisión de Conflitos
# Obtén a túa access_key en https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# hCaptcha - Protección contra spam
# Obtén a túa sitekey en https://dashboard.hcaptcha.com
VITE_HCAPTCHA_SITEKEY=

# Optional Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Biblioteca
# A sección usa ligazóns nativas do Worker a D1, Vectorize e Workers AI.
# Non require cadeas de conexión nin segredos para ler a folla pública.

# demo: catálogo local ficticio; api: Worker real
VITE_CATALOG_MODE=demo
